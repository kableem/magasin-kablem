PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=METTRE_TON_MOT_DE_PASSE_ICI
DB_NAME=magasin_kablem
JWT_SECRET=METTRE_UNE_LONGUE_CLE_SECRETE_ICI
JWT_EXPIRES_IN=8h

# Application mobile (facultatif)
# Origines autorisées en plus du web, séparées par des virgules (ex. https://192.168.1.20:8100)
CORS_ORIGINES=
# HTTPS : certificat Windows .pfx et son mot de passe (serveur), ou bien certificat + clé .pem. Vide = HTTP.
HTTPS_PFX=
HTTPS_PFX_MDP=
HTTPS_CERT=
HTTPS_CLE=

# Mails d'alerte au service logistique (sortie urgente pas terminée après 2 h). Vide = pas de mail.
# MAIL_MODE=outlook : envoi par Outlook classique ouvert sur ce PC (Windows), sans mot de passe ici (Microsoft 365 qui bloque le SMTP) ; vide ou smtp : par les SMTP_* ci-dessous
MAIL_MODE=
# Outlook / Microsoft 365 : SMTP_HOST=smtp.office365.com, SMTP_PORT=587 (« SMTP authentifié » activé sur le compte)
# Gmail (essai) : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, mot de passe d'application Google (pas le mot de passe normal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
